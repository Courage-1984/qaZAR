{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test*)",
      "Bash(npm run build:web*)",
      "Bash(npm run server*)",
      "Bash(npm run dev:web*)",
      "Bash(npm run preview:web*)",
      "Bash(node --check:*)",
      "Bash(node -c:*)",
      "Bash(node --test:*)",
      "Bash(git status*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(npx playwright:*)",
      "Bash(docker build:*)",
      "Bash(docker compose:*)",
      "Bash(curl http://localhost:8787/*)",
      "Bash(curl -s http://localhost:8787/*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./data/**)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)",
      "Bash(npm publish:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.agents/hooks/guard.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.agents/hooks/post-tool.mjs\""
          }
        ]
      }
    ]
  }
}
