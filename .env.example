# Copy to .env. Never commit .env. The API and capture worker load this file on boot.

PORT=8787
# npm run server:tunnel forces the tunnel even when this is 1.
NO_TUNNEL=1

# Partner gate. When set, anonymous POST /api/runs is 401.
LOGI_INK_API_SECRET=
LOGI_INK_OWNER_ID=logi-ink
LOGI_INK_OWNER_EMAIL=
AGENCY_INBOX=

MAIL_PROVIDER=resend
MAIL_API_KEY=
MAIL_FROM=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_SUCCESS_URL=https://logi-ink.co.za/contact?paid=1
STRIPE_CANCEL_URL=https://logi-ink.co.za/contact

# Public API origin used in mailed links. A quick tunnel URL changes on each restart.
QAZAR_PUBLIC_BASE=
QAZAR_API_KEYS=
